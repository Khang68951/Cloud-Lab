{
  "name": "cloudlab",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, practice-heavy platform for learning AWS / cloud system design (and more tracks later).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @cloudlab/api\" \"npm run dev -w @cloudlab/web\"",
    "build": "npm run build -w @cloudlab/web",
    "start": "npm run start -w @cloudlab/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:generate": "npm run db:generate -w @cloudlab/api --",
    "check": "npm run typecheck && npm run lint && npm run test && npm run i18n:check",
    "sim:report": "tsx scripts/sim-report.ts",
    "challenges:report": "tsx scripts/challenges-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
